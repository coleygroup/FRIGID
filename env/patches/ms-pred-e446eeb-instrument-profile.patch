+def _build_instrument2onehot_pos():
+    """Instrument vocab depends on ICEBERG checkpoint family.
+
+    Set ICEBERG_INSTRUMENT_PROFILE before importing ms_pred / launching predict_smis:
+      - msg:     2-class (Orbitrap, QTOF)     -> MSG ckpts
+      - canopus: 3-class (+ Unknown)          -> CANOPUS ckpts (e446eeb default)
+    """
+    import os
+
+    profile = os.environ.get("ICEBERG_INSTRUMENT_PROFILE", "canopus").strip().lower()
+    base = {
+        "Orbitrap": 0,
+        "QTOF": 1,
+    }
+    if profile in {"msg", "2"}:
+        return base
+    if profile in {"canopus", "3", ""}:
+        return {**base, "Unknown": 2}
+    raise ValueError(
+        f"Unknown ICEBERG_INSTRUMENT_PROFILE={profile!r}. "
+        "Expected one of: msg, canopus."
+    )
+
+
+instrument2onehot_pos = _build_instrument2onehot_pos()
 
 
